# Copy to `.env` and fill in. Never commit the filled copy — `.env` is gitignored.
#
# Everything here is only needed to run the *live* system. The measurement in
# `backend/reports/REPORT.md` reproduces with no credentials at all:
#
#     cd backend && python -m app.eval

# --- Supabase (PostgreSQL) -------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Redis (feature store, bandit posteriors, idempotency, ARQ queue) ------
REDIS_URL=redis://default:password@your-host.redns.redis-cloud.com:6379/0

# --- Razorpay (test mode) -------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Set this in the Razorpay dashboard when creating the webhook. Leaving it blank
# disables signature verification, which is fine locally and unacceptable anywhere
# a real endpoint is reachable.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Gemini (complex-case reasoner) --------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# --- App -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=8000

# --- Compliance limits ---------------------------------------------------
# These are the defaults the eval was measured under. Changing one changes what
# the compliance engine refuses, and therefore what the reported lift is worth.
MAX_RETRIES_PER_PAYMENT=3
MAX_CONTACTS_PER_DAY=2
QUIET_HOURS_START=22
QUIET_HOURS_END=8
MAX_RECOVERY_WINDOW_HOURS=72
MIN_RETRY_INTERVAL_MINUTES=15
# NPCI's ₹1,00,000 P2M ceiling, in paise.
UPI_TRANSACTION_CEILING_PAISE=10000000
# Above ₹10,000 an auto-retry needs a standing mandate or explicit customer action.
REQUIRE_ACTION_ABOVE_PAISE=1000000

# --- LLM routing ---------------------------------------------------------
LLM_CONFIDENCE_THRESHOLD=0.7
LLM_AMOUNT_THRESHOLD_PAISE=1000000
