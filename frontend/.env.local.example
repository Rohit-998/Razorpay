# Where the dashboard looks for the API.
#
# Copy this to `.env.local`. Without it the client falls back to http://localhost:8000, which
# is where `uvicorn app.main:app --reload` serves by default — so for local development you do
# not need this file at all.
#
# It matters when the two are not on the same machine. The value it must NOT be is the empty
# string: an empty base resolves to the Next server's own origin, every request 404s against
# the page router, and every panel reports the backend as down while the backend is running.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
